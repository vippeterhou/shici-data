      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "船中江上景，晚泊早行時。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "山寺鐘樓月，江城鼓角風。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "雨過花爭出，雲空月半生。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "鳥正啼隋柳，人須入楚山。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "高松飄雨雪，一室掩香燈。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "遂有冥心者，還尋此境來。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "又因風雨夜，重到古松門。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "道晦金雞伏，時來木馬鳴。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "誰來看山寺，自去掃松門。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "此生還自喜，餘事不相侵。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "白鬢無心鑷，青山得意多。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "一春能幾日，無雨亦多風。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "苦雨秋濤漲，狂風野燒翻。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "須知三尺劍，只為不平磨。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "要路爭先進，閑門肯暫過。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "已難消永夜，況複聽秋霖。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "大雪路亦宿，深山水也吞。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "捲簾黃葉落，鎖印子規啼。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "亡國空流水，孤祠掩落花。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "山魅隔窗舞，鵩鳥入簾飛。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "萬里八九月，一身西北風。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "磴危攀薜荔，石滑疏莓苔。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "日落無行客，天寒有去鴻。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "正思浮世事，又到古城邊。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "尋常風雨夜，應有鬼神看。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "寄宿山中寺，相辭海上僧。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "風吹榆莢葉，雨打木瓜花。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "是星皆拱北，無水不朝東。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "西風起邊雁，一一向瀟湘。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "那堪懷遠路，猶自上高樓。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "白雲風散盡，紅葉水流來。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "妾如無異意，君棄也甘心。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "野過雲根闊，山高樹影長。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "古跡應重別，生緣不暫停。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "一個字未穩，數宵心不閑。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "別地葉頻落，去程山已寒。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "但取詩名得，何論下第頻。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "早起赴前程，鄰雞尚未鳴。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "白地一回雨，兒孫拾得金。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "軒車在何處，雨雪滿前山。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "燈微山館雨，角咽海城秋。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "去帆看已遠，臨水立多時。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "家貧為客早，路遠得書稀。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "瀑布五千仞，草堂瀑布邊。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "我憶雲門寺，門前千萬峰。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "一瓶居無外，萬木老禪中。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "秋江洗一缽，寒日曬三衣。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "空山行客少，獨樹晚蟬多。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "一片月生海，幾家人上樓。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "窗寒風漸緊，燈落夜將深。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "雲夢幾行去，瀟湘一夜空。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "無風來竹院，有月在莎庭。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "故園從小別，夜雨近秋聞。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "書劍別南州，炎荒萬里遊。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "山盤樵徑上，人到雪房遲。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "路經秋雨後，人入亂峰來。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "獨樹知秋早，孤舟覺夜寒。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "馬饑餐落葉，鶴宿曬殘陽。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "路遠春行盡，家貧愁到時。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "臨水通宵坐，知君此興同。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "江聲兼小雨，暝色入啼猿。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "藕隱玲瓏玉，花藏縹緲容。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "紅樹醉秋色，碧溪彈夜弦。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "網斷蛛猶織，梁空燕不歸。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "倒身無著處，呵手不成溫。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "幾多詩弟子，無限酒知聞。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "床上小熏籠，韶州新退紅。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "看時人步澀，展處蝶爭來。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "兢字德源，長安人，梁宰相也。"
    ],
    "format": {
      "sentence_count": 3,
      "sentence_lengths": [4, 3, 4],
      "uniform_sentence_length": null
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "酒味雜蓮氣，香冷勝於冰。"
    ],
    "format": {
      "sentence_count": 2,
      "sentence_lengths": [5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "句",
    "author": "無名氏",
    "paragraphs": [
      "太宗皇帝真長策，賺得英雄盡白頭。"
    ],
    "format": {
