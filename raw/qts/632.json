    "author": "司空圖",
    "paragraphs": [
      "白菊初開臥內明，聞君相訪病身輕。樽前且撥傷心事，",
      "擬將寂寞同留住，且勸康時立大名。"
    ],
    "format": {
      "sentence_count": 5,
      "sentence_lengths": [7, 7, 7, 7, 7],
      "uniform_sentence_length": 7
    }
  },
  {
    "title": "酬張芬赦後見寄",
    "author": "司空圖",
    "paragraphs": [
      "紫鳳朝銜五色書，陽春忽布網羅除。已將心變寒灰後，",
      "勞君故有詩相贈，欲報瓊瑤愧不如。"
    ],
    "format": {
      "sentence_count": 5,
      "sentence_lengths": [7, 7, 7, 7, 7],
      "uniform_sentence_length": 7
    }
  },
  {
    "title": "上元放二雉",
    "author": "司空圖",
    "paragraphs": [
      "嬰網雖皆困，搴籠喜共歸。無心期爾報，相見莫驚飛。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "中秋",
    "author": "司空圖",
    "paragraphs": [
      "閑吟秋景外，萬事覺悠悠。此夜若無月，一年虛過秋。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "偶題",
    "author": "司空圖",
    "paragraphs": [
      "水榭花繁處，春晴日午前。鳥窺臨檻鏡，馬過隔牆鞭。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "閒步",
    "author": "司空圖",
    "paragraphs": [
      "幾處白煙斷，一川紅樹時。壞橋侵轍水，殘照背村碑。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "春中",
    "author": "司空圖",
    "paragraphs": [
      "伏溜侵階潤，繁花隔竹香。嬌鶯方曉聽，無事過南塘。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "獨望",
    "author": "司空圖",
    "paragraphs": [
      "綠樹連村暗，黃花出陌稀。遠陂春草綠，猶有水禽飛。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "雜題",
    "author": "司空圖",
    "paragraphs": [
      "孤枕聞鶯起，幽懷獨悄然。地融春力潤，花泛曉光鮮。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "漫題三首·其一",
    "author": "司空圖",
    "paragraphs": [
      "亂後他鄉節，燒殘故國春。自憐垂白首，猶伴踏青人。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "漫題三首·其二",
    "author": "司空圖",
    "paragraphs": [
      "齒落傷情久，心驚健忘頻。蝸廬經歲客，蠶市異鄉人。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "漫題三首·其三",
    "author": "司空圖",
    "paragraphs": [
      "率怕人言謹，閑宜酒韻高。山林若無慮，名利不難逃。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "河上二首·其一",
    "author": "司空圖",
    "paragraphs": [
      "慘慘日將暮，驅羸獨到莊。沙痕傍墟落，風色入牛羊。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "河上二首·其二",
    "author": "司空圖",
    "paragraphs": [
      "新霽田園處，夕陽禾黍明。沙村平見水，深巷有鷗聲。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "早朝",
    "author": "司空圖",
    "paragraphs": [
      "白日新年好，青春上國多。街平雙闕近，塵起五雲和。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事二首·其一",
    "author": "司空圖",
    "paragraphs": [
      "茶爽添詩句，天清瑩道心。只留鶴一隻，此外是空林。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事二首·其二",
    "author": "司空圖",
    "paragraphs": [
      "禦禮征奇策，人心注盛時。從來留振滯，只待濟臨危。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "永夜",
    "author": "司空圖",
    "paragraphs": [
      "永夜疑無日，危時只賴山。曠懷休戚外，孤跡是非間。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "秦關",
    "author": "司空圖",
    "paragraphs": [
      "形勝今雖在，荒涼恨不窮。虎狼秦國破，狐兔漢陵空。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "渡江",
    "author": "司空圖",
    "paragraphs": [
      "秋江共僧渡，鄉淚滴船回。一夜吳船夢，家書立馬開。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "退居漫題七首·其一",
    "author": "司空圖",
    "paragraphs": [
      "花缺傷難綴，鶯喧奈細聽。惜春春已晚，珍重草青青。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "退居漫題七首·其二",
    "author": "司空圖",
    "paragraphs": [
      "堤柳自綿綿，幽人無恨牽。只憂詩病發，莫寄校書箋。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "退居漫題七首·其三",
    "author": "司空圖",
    "paragraphs": [
      "燕語曾來客，花催欲別人。莫愁春又過，看著又新春。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "退居漫題七首·其四",
    "author": "司空圖",
    "paragraphs": [
      "身外都無事，山中久避喧。破巢看乳燕，留果待啼猿。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "退居漫題七首·其五",
    "author": "司空圖",
    "paragraphs": [
      "詩家通籍美，工部與司勳。高賈雖難敵，微官偶勝君。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "退居漫題七首·其六",
    "author": "司空圖",
    "paragraphs": [
      "努力省前非，人生上壽稀。青雲無直道，暗室有危機。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "退居漫題七首·其七",
    "author": "司空圖",
    "paragraphs": [
      "燕拙營巢苦，魚貪觸網驚。豈緣身外事，亦似我勞形。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其一",
    "author": "司空圖",
    "paragraphs": [
      "宿雨川原霽，憑高景物新。陂痕侵牧馬，雲影帶耕人。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其二",
    "author": "司空圖",
    "paragraphs": [
      "十年深隱地，一雨太平心。匣澀休看劍，窗明複上琴。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其三",
    "author": "司空圖",
    "paragraphs": [
      "明時那棄置，多病自遲留。疏磬和吟斷，殘燈照臥幽。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其四",
    "author": "司空圖",
    "paragraphs": [
      "衰鬢閑生少，丹梯望覺危。松須依石長，鶴不傍人卑。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其五",
    "author": "司空圖",
    "paragraphs": [
      "落葉頻驚鹿，連峰欲映雕。此生詩病苦，此病更蕭條。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其六",
    "author": "司空圖",
    "paragraphs": [
      "旅思又驚夏，庭前長小松。遠峰生貴氣，殘月斂衰容。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其七",
    "author": "司空圖",
    "paragraphs": [
      "林鳥頻窺靜，家人亦笑慵。舊居留穩枕，歸臥聽秋鐘。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其八",
    "author": "司空圖",
    "paragraphs": [
      "華宇知難保，燒來又卻修。只應巢燕惜，未必主人留。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "即事九首·其九",
    "author": "司空圖",
    "paragraphs": [
      "幽鳥穿籬去，鄰翁采藥回。雲從潭底出，花向佛前開。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "松滋渡二首·其一",
    "author": "司空圖",
    "paragraphs": [
      "步上短亭久，看回官渡船。江鄉宜晚霽，楚老語豐年。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "松滋渡二首·其二",
    "author": "司空圖",
    "paragraphs": [
      "楚岫接鄉思，茫茫歸路迷。更堪斑竹驛，初聽鷓鴣啼。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "華清宮",
    "author": "司空圖",
    "paragraphs": [
      "帝業山河固，離宮宴幸頻。豈知驅戰馬，只是太平人。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "牛頭寺",
    "author": "司空圖",
    "paragraphs": [
      "終南最佳處，禪誦出青霄。群木澄幽寂，疏煙泛泬寥。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "感時上盧相",
    "author": "司空圖",
    "paragraphs": [
      "兵待皇威振，人隨國步安。萬方休望幸，封嶽始鳴鑾。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "亂後三首·其一",
    "author": "司空圖",
    "paragraphs": [
      "喪亂家難保，艱虞病懶醫。空將憂國淚，猶擬灑丹墀。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "亂後三首·其二",
    "author": "司空圖",
    "paragraphs": [
      "流芳能幾日，惆悵又聞蟬。行在多新貴，幽棲獨長年。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "亂後三首·其三",
    "author": "司空圖",
    "paragraphs": [
      "世事嘗艱險，僧居慣寂寥。美香聞夜合，清景見寅朝。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "秋景",
    "author": "司空圖",
    "paragraphs": [
      "景物皆難駐，傷春複怨秋。旋書紅葉落，擬畫碧雲收。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "避亂",
    "author": "司空圖",
    "paragraphs": [
      "離亂身偶在，竄跡任浮沉。虎暴荒居迥，螢孤黑夜深。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "長亭",
    "author": "司空圖",
    "paragraphs": [
      "梅雨和鄉淚，終年共酒衣。殷勤華表鶴，羨爾亦曾歸。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "村西杏花二首·其一",
    "author": "司空圖",
    "paragraphs": [
      "薄膩力偏羸，看看愴別時。東風狂不惜，西子病難醫。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "村西杏花二首·其二",
    "author": "司空圖",
    "paragraphs": [
      "肌細分紅脈，香濃破紫苞。無因留得玩，爭忍折來拋。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "獨坐",
    "author": "司空圖",
    "paragraphs": [
      "幽徑入桑麻，塢西逢一家。編籬薪帶繭，補屋草和花。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "借居",
    "author": "司空圖",
    "paragraphs": [
      "借住郊園久，仍逢夏景新。綠苔行屐穩，黃鳥傍窗頻。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "重陽",
    "author": "司空圖",
    "paragraphs": [
      "菊開猶阻雨，蝶意切於人。亦應知暮節，不比惜殘春。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "偶書五首·其一",
    "author": "司空圖",
    "paragraphs": [
      "衰謝當何懺，惟應悔壯圖。磬聲花外遠，人影塔前孤。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "偶書五首·其二",
    "author": "司空圖",
    "paragraphs": [
      "色變鶯雛長，竿齊筍籜垂。白頭身偶在，清夏景還移。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "偶書五首·其三",
    "author": "司空圖",
    "paragraphs": [
      "蜀妓輕成妙，吳娃狎共纖。晚妝留拜月，卷上水精簾。"
    ],
    "format": {
      "sentence_count": 4,
      "sentence_lengths": [5, 5, 5, 5],
      "uniform_sentence_length": 5
    }
  },
  {
    "title": "偶書五首·其四",
